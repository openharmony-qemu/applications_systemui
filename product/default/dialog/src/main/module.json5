{
  "module": {
    "name": "default_dialog",
    "type": "feature",
    "srcEntrance": "./ets/Application/AbilityStage.ts",
    "deviceTypes": [
      "default"
    ],
    "metadata": [
      {
        "name": "ArkTSPartialUpdate",
        "value": "true"
      }
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "uiSyntax": "ets",
    "pages": "$profile:main_pages",
    "requestPermissions": [
      { "name": "ohos.permission.MANAGE_AUDIO_CONFIG" },
      { "name": "ohos.permission.GET_BUNDLE_INFO_PRIVILEGED" },
      { "name": "ohos.permission.SYSTEM_FLOAT_WINDOW" }
    ],
    "extensionAbilities": [
      {
        "name": "PlaybackCaptureConsentExtension",
        "srcEntrance": "./ets/ServiceExtAbility/PlaybackCaptureConsentExtension.ets",
        "type": "sys/commonUI",
        "exported": false
      },
      {
        "exported": true,
        "srcEntrance": "./ets/ServiceExtAbility/ExtAbility.ts",
        "name": "com.ohos.systemui.dialog",
        "description": "$string:mainability_description",
        "type": "service",
        "permissions": [
          "ohos.permission.START_SYSTEM_DIALOG"
        ]
      }
    ]
  }
}